# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets or personal network details.
#
# Shared by both standalone/orchestrator.py (the lightweight test script) and the full
# cozmo_brain/ package.

# --- Secrets ---

# Groq API key, used for both STT (Whisper) and TTS (Orpheus).
# Get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API key. Only needed if STT_PROVIDER or TTS_PROVIDER below is set to
# openai — e.g. if Groq's free-tier rate limits get hit. Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Wit.ai (Meta) Server Access Token. Only needed if STT_PROVIDER below is set
# to "witai" — a free, no-billing STT alternative (no TTS product exists, so
# this only ever satisfies STT). Get one at https://wit.ai: log in with a
# Facebook/Meta account, create a new app, then Settings -> API Details ->
# Server Access Token. See cozmo_brain/llm/witai_client.py.
WITAI_ACCESS_TOKEN=your_witai_server_access_token_here

# --- Chat/LLM provider ---

# Which provider does chat/tool-calling (the "brain" driving CozmoEngine).
# "ollama" (default), "groq", or "openai" — the latter two need
# GROQ_API_KEY/OPENAI_API_KEY above and support tool-calling directly via
# their own hosted chat-completions endpoints. See
# cozmo_brain/llm/__init__.py's create_chat_client().
CHAT_PROVIDER=ollama

# Which provider handles a turn with an image attached (`look`/
# `who_is_this`) — independent of CHAT_PROVIDER above, so e.g.
# CHAT_PROVIDER=ollama + VISION_PROVIDER=groq is valid: regular chat/
# tool-calling stays on Ollama, only vision turns go to Groq instead. Left
# empty (default), falls back to CHAT_PROVIDER — same provider for both,
# just possibly a different *model* within it (see GROQ_VISION_MODEL etc.
# below). "ollama", "groq", or "openai".
VISION_PROVIDER=

# Request timeout in seconds for CHAT_PROVIDER=groq/openai chat calls
# (Ollama has its own OLLAMA_TIMEOUT_S below).
CHAT_TIMEOUT_S=60

# Model name for CHAT_PROVIDER=groq/openai — must support tool-calling.
# Current, tool-capable, cost-efficient picks as of when this was written;
# check console.groq.com/docs/models or platform.openai.com/docs/models if
# either 404s or gets deprecated.
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
OPENAI_CHAT_MODEL=gpt-4o-mini

# Model used instead, for whichever CHAT_PROVIDER is active, on any turn
# with an image attached (the `look`/`who_is_this` tools) — only matters
# when the regular chat model above isn't itself vision-capable. Left
# empty, each falls back to its own chat model above. GROQ_VISION_MODEL
# keeps an explicit value so switching GROQ_CHAT_MODEL to a text-only model
# doesn't silently break `look`; OPENAI_CHAT_MODEL's default (gpt-4o-mini) already handles vision
# itself, so OPENAI_VISION_MODEL is left empty by default.
OLLAMA_VISION_MODEL=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OPENAI_VISION_MODEL=

# --- Ollama (tool-calling LLM) ---

# Base URL of the Ollama instance reachable from wherever this runs.
# Can be a local Ollama install or a LAN box proxying Ollama cloud models.
OLLAMA_BASE_URL=http://192.168.1.200:41438

# Model name. Must support `tools` (tool-calling); doesn't need `vision` too
# anymore unless OLLAMA_VISION_MODEL above is left empty — see docs/providers.md for
# tested models.
OLLAMA_MODEL=gemma4:31b-cloud

# Request timeout in seconds for each Ollama chat call.
OLLAMA_TIMEOUT_S=60

# --- Audio input (mic) ---

# Seconds to record per turn in push-to-talk mode (--mode voice).
RECORD_SECONDS=5

# ALSA/PipeWire device name to record from. Run `arecord -L` on the Pi to list
# options — "pipewire" is typical after routing a Bluetooth mic through PipeWire.
RECORD_DEVICE=pipewire

# --- Audio output routing ---

# "cozmo" (default) plays speech only through Cozmo's own speaker. "system"
# plays only through this machine's own audio output instead (e.g. the same
# Bluetooth speaker used for the mic) — useful in a noisy room where Cozmo's
# tiny speaker isn't loud/clear enough even with TTS_GAIN. "both" plays
# through both at once (simultaneous, not sequential), so Cozmo still
# "performs" the line while it's also actually intelligible.
AUDIO_OUTPUT=cozmo

# ALSA/PipeWire device name to play system audio through when AUDIO_OUTPUT
# is "system" or "both". Run `aplay -L` on the Pi to list options.
PLAYBACK_DEVICE=pipewire

# --- Speech providers (STT and TTS, configured independently) ---

# Which provider does speech-to-text and which does text-to-speech.
# "groq" (default), "openai", or "local" for each, set separately — e.g.
# STT_PROVIDER=groq + TTS_PROVIDER=openai is valid, not just a matched pair.
# Switch either to "openai" if Groq's free-tier rate limits get hit (needs
# OPENAI_API_KEY above), or to "local" to run fully offline with no API key
# at all (see the Local STT/TTS section below). STT_PROVIDER only can also
# be "witai" (Wit.ai/Meta, free, no billing, STT only — see WITAI_ACCESS_TOKEN
# above). TTS_PROVIDER only can also be "edge" (Microsoft Edge's online TTS,
# free, no key, needs internet, TTS only — see the Edge TTS section below).
# Setting TTS_PROVIDER=witai or STT_PROVIDER=edge will fail — each is only
# ever the other half. See cozmo_brain/llm/__init__.py's create_speech_client().
STT_PROVIDER=groq
TTS_PROVIDER=groq

# --- Groq STT/TTS (used when STT_PROVIDER/TTS_PROVIDER=groq) ---

GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Voice. Options: troy, austin, daniel (male) | autumn, diana, hannah (female)
GROQ_TTS_VOICE=austin

# Groq's own native speed control (confirmed in its API reference: range
# 0.5-5.0, default 1.0 — same idea as OPENAI_TTS_SPEED below).
GROQ_TTS_SPEED=1.0

# --- OpenAI STT/TTS (used when STT_PROVIDER/TTS_PROVIDER=openai) ---
# Model/voice names are OpenAI's own — not interchangeable with Groq's above.

OPENAI_STT_MODEL=whisper-1

# --- Whisper hallucination defenses (STT_PROVIDER=groq/openai/local) ---
# Language hint (ISO-639-1). Stops Whisper guessing a language on noise -
# the source of foreign-language hallucinations. Empty = auto-detect.
STT_LANGUAGE=en
# Per-segment confidence filters - a segment is dropped if Whisper's own
# no-speech estimate is above STT_NO_SPEECH_PROB, its decoding confidence
# is below STT_MIN_AVG_LOGPROB, or it's a repetitive loop (compression
# above STT_MAX_COMPRESSION_RATIO). Every segment's scores are logged
# ("STT segment kept/DROPPED ...") so these can be tuned from real audio.
# Measured live: OpenAI whisper-1's no-speech estimate separates noise
# (0.93+) from speech (0.00) cleanly; Groq's is always 0.00, so on Groq only
# the logprob floor helps - tighten it (e.g. toward -0.5) once your real
# speech's logprob is known from the logs. Non-Whisper models (e.g.
# gpt-4o-transcribe) don't report these and are unaffected.
STT_NO_SPEECH_PROB=0.6
STT_MIN_AVG_LOGPROB=-1.0
STT_MAX_COMPRESSION_RATIO=2.4

# Neural speech check (Silero VAD) on every captured clip BEFORE it's sent
# to any STT provider - noise with no real speech in it is never sent, so no
# provider gets a chance to hallucinate on it (and no STT call is spent).
# Uses the Silero model bundled in faster-whisper - no extra download; if
# faster-whisper isn't installed, this is skipped and clips are sent as
# before. Measured with the real model (two runs): noise 0.00-0.06s of speech,
# one-word replies 0.42-0.67s. Each clip's result is logged ("Speech gate (Silero):
# 0.48s of speech detected ...") - lower SPEECH_GATE_MIN_SPEECH_MS if real
# short replies ever get "not sent".
SPEECH_GATE_ENABLED=true
SPEECH_GATE_MIN_SPEECH_MS=150
SPEECH_GATE_THRESHOLD=0.5

# Options: tts-1 (fast) or tts-1-hd (higher quality, slower/pricier).
OPENAI_TTS_MODEL=tts-1

# Options: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage,
# shimmer, verse, marin, cedar.
OPENAI_TTS_VOICE=alloy

# OpenAI's own speed control (0.25-4.0, native to their TTS API). Measured
# directly: "alloy" speaks ~14% faster than Groq's Orpheus "austin" for
# identical text — try ~0.85-0.90 to roughly match Groq's pacing if that's
# noticeable. 1.0 = OpenAI's own default.
OPENAI_TTS_SPEED=1.0

# --- Local STT/TTS (used when STT_PROVIDER/TTS_PROVIDER=local) ---
# Fully offline, no API key, no rate limits — faster-whisper (CTranslate2)
# for STT, Piper for TTS. Needs `pip install faster-whisper piper-tts`
# (commented out in requirements.txt by default — read the note there about
# piper-tts's GPL-3.0 license first) and a downloaded Piper voice, saved
# into models/ (run from the project folder):
# python3 -m piper.download_voices en_US-lessac-medium --data-dir models
# See cozmo_brain/llm/local_client.py.

# Whisper model size: tiny/base/small/medium/large-v3 — bigger is more
# accurate but slower on the Pi's CPU-only hardware. "base" is a starting
# guess to tune from real latency on real hardware, not a measured choice
# (no Pi available here to benchmark on) — drop to "tiny" if it's not fast
# enough. First run downloads the model from Hugging Face into a local
# cache (~/.cache/huggingface/hub by default — see docs/providers.md); every run
# after that is offline.
#
# Also accepts a full Hugging Face repo id directly (anything with a "/"),
# not just the short names above — same cache either way. Worth trying for
# the tiny/base-speed vs. small-accuracy trade-off specifically:
# LOCAL_STT_MODEL=Systran/faster-distil-whisper-small.en
# (distil-whisper: ~6x faster than the equivalent full-size model at ~1%
# worse WER, English-only. See docs/providers.md, local STT/TTS.)
LOCAL_STT_MODEL=base

# "cpu" — the Pi has no GPU. "int8" quantization is CTranslate2's fastest
# CPU compute type, at some accuracy cost vs "float32"/"int8_float16".
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8

# A downloaded Piper voice: its name in models/ (en_US-lessac-medium loads
# models/en_US-lessac-medium.onnx), or a path to its .onnx file. Its sibling
# .onnx.json must sit alongside it. "medium" quality voices are Piper's own
# recommended tier for Raspberry Pi-class hardware; drop to a "low" quality
# voice instead if it's not fast enough on the real Pi.
LOCAL_TTS_VOICE_PATH=en_US-lessac-medium

# Speed — same direction/semantics as GROQ_TTS_SPEED/OPENAI_TTS_SPEED
# above (>1.0 = faster, 1.0 = default), even though Piper's own
# SynthesisConfig takes the inverse ("length_scale", >1.0 = slower) —
# local_client.py converts.
LOCAL_TTS_SPEED=1.0

# --- Edge TTS (used when TTS_PROVIDER=edge) ---
# Microsoft Edge's online TTS via the unofficial `edge-tts` library — free,
# no API key, needs internet (an unofficial, reverse-engineered endpoint,
# not a published/supported Microsoft product). TTS only, no STT
# counterpart. Needs `pip install edge-tts av` (commented out in
# requirements.txt by default). See cozmo_brain/llm/edge_client.py.

# A stock edge-tts voice name. List them all with `edge-tts --list-voices`.
EDGE_TTS_VOICE=en-US-EmmaMultilingualNeural

# Same direction/semantics as GROQ_TTS_SPEED/OPENAI_TTS_SPEED/
# LOCAL_TTS_SPEED (>1.0 = faster, 1.0 = default) — converted to edge-tts's
# own signed-percentage "rate" string (e.g. "+20%") in edge_client.py.
EDGE_TTS_SPEED=1.0

# --- TTS output shape (applies regardless of provider) ---

# Sample rate Cozmo's play_audio() requires (22050 or 48000 Hz, 16-bit).
# Groq's Orpheus can be asked for this rate directly; OpenAI's TTS cannot
# (no such parameter exists in its API) — either way, this is the rate
# tts_postprocess.py resamples to before handing audio to Cozmo, so it's
# always correct regardless of provider. Don't change unless you know why.
TTS_SAMPLE_RATE=22050

# Maximum volume boost applied to TTS output before sending to Cozmo — his
# speaker is quiet even at max hardware volume. This is a ceiling toward a
# target RMS (average loudness), not a peak target — matching peaks alone
# left "peakier" voices (confirmed: OpenAI's default) sounding quieter
# overall than Groq's despite an identical peak. A soft limiter (not a
# hard ceiling) protects against overflow, so this can go higher than a
# pure peak-based approach could safely allow. 1.0 = no boost.
TTS_GAIN=4.0

# Silent lead-in prepended before the actual speech (milliseconds).
# Reported symptom: Cozmo's speaker often misses the first word, the rest
# plays fine — likely a hardware audio warm-up after a run of silence, not
# a queueing bug. Untested against real hardware how much is actually
# needed; 0 disables it.
TTS_LEADIN_MS=200

# Voice character: Orpheus's voices are generic human voices, not Cozmo's
# real (small, robotic) one — these two settings are a cheap approximation,
# not a faithful recreation (the ring-mod effect alone doesn't actually read
# as "Cozmo"). Defaults below were picked by ear from sample WAVs as the best
# available combo. See cozmo_brain/llm/groq_client.py for how each works.

# Pitch+tempo shift via resampling ("chipmunk" trick). >1.0 = higher/faster
# (smaller, more childlike/robotic), <1.0 = lower/slower. 1.0 = no change.
TTS_PITCH_SHIFT=1.10

# Ring modulation: mixes in a fixed-frequency carrier tone for a metallic
# robotic timbre. Depth 0.0 = off. Carrier frequency in Hz — lower (~20-40Hz)
# is a subtle buzz, higher gets harsher.
TTS_ROBOT_MOD_DEPTH=0.25
TTS_ROBOT_MOD_HZ=35.0

# --- Scratch audio/image file paths (relative to project dir) ---

RAW_INPUT_WAV=input.wav
TTS_OUTPUT_WAV=cozmo_reply.wav
CAMERA_SNAPSHOT_PATH=data/look.png

# Reference photos for remember_person/who_is_this (experimental — see docs/people-recognition.md).
KNOWN_PEOPLE_DIR=data/known_people

# --- cozmo_brain/ package only (standalone/orchestrator.py ignores these) ---

# "real" talks to an actual Cozmo over PyCozmo. "simulated" logs actions to
# the console instead of touching hardware — useful for development away
# from the robot. Overridden by --simulate on the CLI regardless of this.
ROBOT_BACKEND=real

# Default log level for cozmo_brain (case-insensitive): INFO shows the
# useful diagnostics (LLM steps/tool results, STT results + segment scores,
# speech-gate/capture lines, docking); WARNING is quiet (problems only);
# ERROR only failures; DEBUG everything incl. PyCozmo's chatter. The
# --log-level flag overrides this for a single run.
LOG_LEVEL=INFO

# Seconds without robot telemetry before the connection is treated as dropped
# and a reconnect is attempted automatically (see robot/real.py). Inferred
# from the protocol, not tuned against a real disconnect — raise this if you
# see spurious reconnects, lower it for faster recovery.
ROBOT_STALE_AFTER_S=5.0
# How often to check the connection in the background (and reconnect if it's
# stale), so a drop is caught while Cozmo is idle too - not only before the
# next tool call. While disconnected it retries every 30s at most. Logs only
# when the state changes ("Connection check: ..."). 0 = off.
CONNECTION_CHECK_INTERVAL_S=120.0

# --- Battery monitor (real backend only, see robot/battery_monitor.py) ---
# Voltage thresholds sourced from real-world Cozmo community usage: 3.7V is
# used as a "seek charger" threshold in a working autonomy script, 3.5V is
# reported as the official SDK's own low-battery warning level. Below
# BATTERY_LOW_VOLTAGE, a battery icon + red backpack light are shown on a
# timer (BATTERY_CHECK_INTERVAL_S) so there's a visible warning before Cozmo
# actually dies. Below BATTERY_CRITICAL_VOLTAGE the icon shows a warning mark
# instead of a fill level. SimulatedRobot always reports a healthy voltage,
# so this never fires in --simulate/ROBOT_BACKEND=simulated.
# BATTERY_CHECK_INTERVAL_S is also how often a low/critical level is noticed:
# the battery can fall from low to critical quickly, so a shorter interval
# leaves more time to get back to the charger (each level must hold for 2
# checks, so 15s = a level is confirmed after about 30s).
BATTERY_LOW_VOLTAGE=3.7
BATTERY_CRITICAL_VOLTAGE=3.5
BATTERY_CHECK_INTERVAL_S=15.0

# Low-battery return-to-charger (see cozmo_brain/charger_return.py). Cozmo
# remembers where the charger is each time he drives off it (in memory only
# - forgotten on pickup or reconnect, since his pose tracking resets then).
# At BATTERY_LOW_VOLTAGE he offers out loud to head back (just answer "yes"
# the normal way); at BATTERY_CRITICAL_VOLTAGE he goes back on his own. Each
# level must hold for 2 consecutive BATTERY_CHECK_INTERVAL_S checks first.
# If he doesn't know where the charger is, he asks to be put on it instead.
# false turns all of that off (the `dock` tool still navigates back when
# explicitly asked).
AUTO_RETURN_TO_CHARGER_ENABLED=true
# Upper bound on one navigation leg before it's aborted - pycozmo's
# go_to_pose() has no timeout of its own. A generous untuned guess.
RETURN_TO_POSE_TIMEOUT_S=60.0

# Optional: auto-join Cozmo's Wi-Fi AP on connect (Linux/nmcli only, e.g. the
# Pi). Leave COZMO_WIFI_SSID empty to keep connecting manually as before.
# First run needs COZMO_WIFI_PASSWORD too (from his face); after that, nmcli
# saves the profile and the password is no longer needed — his SSID doesn't
# usually change, but if it ever does, update this and reconnect once more.
COZMO_WIFI_SSID=
COZMO_WIFI_PASSWORD=

# turn() calibration — see `python -m cozmo_brain --mode calibrate` to measure
# real values for your robot instead of guessing.
TURN_SPEED_MMPS=40.0
TURN_SECONDS_PER_DEGREE=0.02222

# Safety clamps applied to the drive() tool.
MAX_DRIVE_SPEED_MMPS=150.0
MAX_DRIVE_DISTANCE_MM=1000.0

# How far/fast to drive straight when a turn is requested while still
# resting (full) on the charger, before performing that turn - confirmed on
# real hardware that turning in place on/near the dock risks catching on
# it, and its platform/edge falsely trips CLIFF_DETECTED anyway (see
# robot/real.py). 150mm confirmed on real hardware as actually enough to
# clear the dock - 100mm (the original guess) was observed not reliably
# clearing it.
CHARGER_EXIT_DISTANCE_MM=150.0
CHARGER_EXIT_SPEED_MMPS=60.0

# How far/fast the `dock` tool reverses onto the charger (see
# RobotBackend.dock() in robot/base.py) - the same false-CLIFF_DETECTED
# platform/edge geometry as above, just approached from the opposite
# direction. Same magnitude as the confirmed exit distance, since it's the
# same physical platform/edge - not itself independently confirmed on real
# hardware yet.
CHARGER_DOCK_DISTANCE_MM=150.0
CHARGER_DOCK_SPEED_MMPS=60.0
# The dock reverse keeps going up to this much past CHARGER_DOCK_DISTANCE_MM, but
# stops the moment the charger contacts engage - confirmed on real hardware
# that the exact distance alone fell short (an extra ~40mm seated it).
CHARGER_DOCK_OVERSHOOT_MM=50.0
# How long to wait after the dock reverse for the charger contacts to read
# as engaged before calling it a miss - confirmed on real hardware that this
# flag can lag well behind actually being seated. Log line "Charger contacts
# engaged X.XXs after..." shows the real delay; tune this from that.
CHARGER_CONTACT_WAIT_S=10.0
# The dock reverse steers to stay on the charger's heading: mm/s of tread
# speed difference per degree off (0 = off, a plain blind reverse). Confirmed
# on real hardware that a tread caught the charger entrance and twisted him
# -17deg. First guess, not tuned - log line "Heading twisted ..." shows jams.
CHARGER_DOCK_HEADING_GAIN=2.0
# Twisted more than this off the charger's heading during the reverse, even
# with steering = caught on the charger: stop the reverse.
CHARGER_DOCK_JAM_DEG=10.0
# After a missed dock, drive back out to the staging point and retry this
# many times.
CHARGER_DOCK_RETRIES=1

# How many LLM<->tool round-trips are allowed in a single user turn before
# the engine gives up and returns whatever it has (prevents runaway loops).
MAX_TOOL_ITERATIONS=4
# The LLM call after a reply that ends in a clean `say` (the model usually
# just answers "done"): async (default) = listen right away and make the
# call in the background, pausing the recording if the model continues
# (--mode vad only; other modes behave as sync); sync = wait for it before
# listening again (~1-2s mic-closed - the fallback if async ever misbehaves);
# skip = don't make it (fastest, but a model that says "sure!" alone and
# acts in its next step - confirmed with openai/gpt-oss-120b - loses the
# action). See docs/turn-flow.md.
FINAL_LLM_CALL=async

# How many messages the model sees (system prompt + recent history) before
# older ones are dropped from its context. Nothing is lost: every run is
# archived in full under DATA_DIR/history/ and the next run resumes from it.
CONVERSATION_MAX_MESSAGES=40

# Everything Cozmo saves at runtime, relative to the project folder:
# history/<date>/<time>.jsonl (one transcript per run, photos next to it),
# memory.md (facts about people - edit freely), known_people/, look.png.
# Read transcripts with: python3 standalone/show_history.py
DATA_DIR=data

# Delete archived days older than this many days at startup. 0 = keep
# everything forever.
HISTORY_RETENTION_DAYS=0

# Most facts Cozmo may save to memory.md via remember_fact. The whole memory
# is sent to the chat provider with every turn, so this caps its cost.
MEMORY_MAX_FACTS=40

# After each conversation, one LLM call looks for things worth remembering
# that Cozmo didn't save live. They wait in memory.md's "Suggested (not yet
# approved)" section - never treated as known - until he asks and you say
# keep (or you move the line yourself). Nothing is added when nothing
# meaningful was said. false = no check, no extra call.
MEMORY_SUGGESTIONS_ENABLED=true

# The old single-file history. Only read once at startup, to import it into
# the archive (then moved to DATA_DIR/conversation_history.imported.json).
CONVERSATION_HISTORY_PATH=conversation_history.json

# Voice activity detection tuning for --mode vad (requires `pip install webrtcvad-wheels`).
# Aggressiveness 0-3 (higher = more likely to classify audio as non-speech).
VAD_AGGRESSIVENESS=2
VAD_SILENCE_MS=800
VAD_MAX_UTTERANCE_S=15

# How long to keep listening for a follow-up after Cozmo replies, without
# needing the wake word again. Resets every turn; once nothing is heard
# within this window, the wake word is required again.
VAD_FOLLOWUP_TIMEOUT_S=15

# When Cozmo speaks up on his own with something you may want to answer - a
# background ask_assistant answer, or the low-battery "head back to the
# charger?" offer - listen this many seconds afterwards without the wake word,
# so a plain "yes" works. 0 = off (wake word or tap needed, as before).
SPEAK_UP_LISTEN_S=10

# Onset debounce, NOT a minimum utterance length: how many consecutive
# milliseconds of webrtcvad-positive audio are required before a capture is
# committed to recording at all. Without this, a single false-positive frame
# from background noise (cheap Bluetooth mics can trigger this easily) was
# enough to trigger a full recording and get sent to Whisper, which doesn't
# reliably return empty text on a noise-only clip - it hallucinates a
# plausible-sounding sentence instead (a well-documented Whisper failure
# mode; reported symptom was Cozmo "hearing" full sentences, sometimes in
# other languages, out of silence). Once this debounce is satisfied there's
# no further minimum on total length - real words can be legitimately short.
# An earlier version of this setting (300ms) required a minimum *total*
# speech-frame count across the whole capture instead of just at onset, and
# that discarded genuinely short real replies (confirmed on real hardware)
# just as readily as actual noise - raise this only if false transcriptions
# persist, and expect to need to raise it a lot less than that old value.
VAD_MIN_SPEECH_MS=60

# Loudness (RMS, 16-bit PCM scale 0-32767) floor a frame must clear, IN
# ADDITION to webrtcvad classifying it as speech, to count as real speech at
# all. webrtcvad only looks at spectral shape, not loudness, so it can't
# tell quiet background noise that happens to look speech-shaped from
# someone actually talking into the mic - this is an independent second
# signal for exactly that gap. Confirmed on real hardware to matter: the
# onset debounce above wasn't enough on its own in a genuinely noisy room,
# reliably clearing a 2-frame debounce and burning through free-tier STT
# quota on noise. UNVERIFIED default - no real audio was available here to
# calibrate this number; cozmo_brain/audio/vad.py logs the actual peak RMS
# seen on both accepted and rejected captures specifically so this can be
# tuned from real data. If real speech keeps getting rejected, lower it; if
# noise keeps getting accepted, raise it (compare the logged peak-RMS
# values for each case to pick a number that sits between them).
VAD_MIN_RMS=150

# Wake word for --mode vad (gates VAD so Cozmo doesn't react to everything
# picked up by the mic). Requires openwakeword, installed specially — see
# cozmo_brain/audio/wakeword.py for the exact command, it's not a plain
# `pip install openwakeword`. One of:
#   - a custom model's name in models/, without the extension: hey_cozmo
#     loads models/hey_cozmo.onnx (trained with
#     training/wake_word_training.ipynb - see docs/wake-word.md)
#   - a stock model name: hey_jarvis, alexa, hey_mycroft, hey_rhasspy,
#     timer, weather
#   - a path to an .onnx file anywhere
# Swapping is just changing this value, no code changes.
WAKE_WORD_MODEL=hey_cozmo
WAKE_WORD_THRESHOLD=0.5

# --- Tap-to-talk (an alternate --mode vad activation trigger, alongside the
# wake word - real backend only; see modes/vad_mode.py) ---
# A tap is a brief spike in accelerometer magnitude above a slow-moving
# rolling baseline (see robot/real.py). Picked from real-hardware logs:
# resting jitter stayed within ~50 of baseline, a genuine tap spiked several
# hundred to 1000+. A sustained multi-sample event (picked up off the
# charger, carried, set back down) produces spikes in the same range, but is
# separately and more reliably rejected via the real IS_PICKED_UP status
# flag, not this threshold - so this only needs to clear noise, not tell a
# tap from a pickup. Lower it if real taps aren't registering; raise it if
# ambient vibration (e.g. driving, nearby footsteps) triggers false taps.
# 150 was too low: an idle, untouched Cozmo logged false taps of 159-187
# (2026-09-30), while a real tap measured 1567 - the "Tap detected: accel
# jump N" log line shows each accepted tap's value, for tuning this.
TAP_THRESHOLD=600.0

# Minimum time between two accepted taps. Without this, a single tap's
# multi-sample "ringing" (confirmed on real hardware: one tap can cross the
# threshold on 2-3 consecutive RobotState packets) would register as several.
TAP_DEBOUNCE_MS=450

# --- Idle fidgeting ---
# After this many seconds with no real conversation turn, a small idle-
# appropriate gesture (peek/shrug) plays every interval this long while the
# quiet continues - purely cosmetic personality, not sensor-driven, so no
# calibration concern like the tap/cliff settings above. See idle_fidget.py.
#
# Raised directly on real hardware: the original 300s (5 min) default never
# actually got a chance to fire - Cozmo disconnects/powers off (its own
# hardware-level inactivity behavior, not anything in this codebase) well
# before 5 minutes of quiet elapses. 30s is a deliberately short
# replacement - roughly VAD_FOLLOWUP_TIMEOUT_S's 15s wake-word window plus
# another 15s - so it gets a real chance to run before that happens.
IDLE_FIDGET_ENABLED=true
IDLE_FIDGET_AFTER_S=30

# --- Start / end animations ---
# Play Cozmo's real wake-up clip when the program starts and go-to-sleep clips
# when it ends (face, head, lift and lights - wheels are never driven, and
# PyCozmo plays no sound for clips). false = the built-in wake_up / sleep
# gestures instead. Needs `pycozmo_resources.py download`; without it the
# gestures play anyway.
WAKE_SLEEP_CLIPS=true

# --- Charger break (step off the dock now and then) ---
# After CHARGER_BREAK_AFTER_MIN continuous minutes docked, Cozmo says so and
# drives off the charger (the usual CHARGER_EXIT_* drive), then drives back
# on his own after a random STRETCH_MIN..STRETCH_MAX minutes - rest for the
# charger/battery on an old device without waiting for it to run low. Only
# when quiet (IDLE_FIDGET_AFTER_S), not mid-conversation, and not while the
# battery is too low to leave (the same BATTERY_LOW_VOLTAGE rule as every
# movement - no separate voltage to guess; data/battery.jsonl records how
# this robot's battery actually behaves, see battery_report.py). The timer
# restarts whenever he leaves the dock for any reason; an exit by an idle
# peek or by asking "come out" (leave_charger) gets no timed return - the
# low/critical battery rules bring him back as before. There is no
# temperature sensor: this is a time limit, not an overheat detector.
# Off by default: it moves him unprompted (mind the table edge).
CHARGER_BREAK_ENABLED=false
CHARGER_BREAK_AFTER_MIN=30
CHARGER_BREAK_STRETCH_MIN=5
CHARGER_BREAK_STRETCH_MAX=10

# --- Presence check (who's in front of Cozmo) ---
# In place of an idle fidget, Cozmo occasionally tilts his head up at the
# chair, takes a photo and asks the vision model who it is (matching the
# reference photos saved by remember_person). A known person is just noted
# silently so Cozmo can use their name; a stranger gets one casual "who are
# you?" at most every PRESENCE_ASK_COOLDOWN_S. The photo is deleted straight
# after. Needs IDLE_FIDGET_AFTER_S quiet first, so it never interrupts a chat.
# PRIVACY: each look sends a photo of whoever is there to VISION_PROVIDER -
# leave this false with a cloud provider unless everyone in the room is fine
# with that. Recognition is a blurry-photo guess, never an identity check.
PRESENCE_CHECK_ENABLED=false
# Head tilt for the look, in degrees (robot maximum is about 44). Raise it if
# the photos cut off faces, lower it if they show the ceiling.
PRESENCE_HEAD_ANGLE_DEG=35
# Seconds before the next look after: a known person / nobody / a stranger.
PRESENCE_RECHECK_S=900
PRESENCE_EMPTY_RETRY_S=300
PRESENCE_ASK_COOLDOWN_S=3600

# --- External assistant (the ask_assistant tool) ---
# Lets Cozmo hand requests he can't do himself - reminders, web lookups,
# tasks - to your own personal assistant agent, over an OpenAI-compatible
# /v1/chat/completions endpoint (written against OpenClaw's gateway; its
# chat-completions endpoint must be enabled there). Cozmo calls it by
# ASSISTANT_NAME and tells you the answer.
# Before anything that affects someone else (messaging people, buying,
# deleting) he reads it back and asks first. Only the one request is sent,
# never Cozmo's conversation. Off by default.
ASSISTANT_ENABLED=false
ASSISTANT_NAME=Assistant
# Base URL, without /v1/chat/completions. OpenClaw's gateway port is 18789.
ASSISTANT_URL=http://<assistant-host>:18789
ASSISTANT_TOKEN=your_assistant_gateway_token_here
# The request's `model` field - for OpenClaw it picks the agent:
# openclaw/<agentId> (openclaw/default = the default agent).
ASSISTANT_MODEL=openclaw/default
# Sent as the request's `user` field: OpenClaw keeps one ongoing session per
# value, so the assistant remembers earlier requests. Change it for a fresh one.
ASSISTANT_SESSION_USER=cozmo
# true: Cozmo says "I've asked <name>", carries on, and speaks up with the
# answer when it arrives (a real web lookup took ~28s). false: he says "let
# me ask <name>" and waits silently, mic closed, for the answer.
ASSISTANT_BACKGROUND=true
# Longest wait for an answer (agent runs with web searches, or a rate-limited
# agent model, can be slow). Lower it with ASSISTANT_BACKGROUND=false.
ASSISTANT_TIMEOUT_S=180

# --- Gesture/speech concurrency ---
# Whether the `gesture` tool runs asynchronously (starts the choreography on
# a background thread and returns immediately) instead of blocking until it
# finishes, so a `say` call right after actually overlaps with the gesture
# instead of waiting on it - confirmed thread-safe at the protocol level,
# but end-to-end on real hardware is genuinely new. Set false to fall back
# to the old strictly-sequential behavior if it misbehaves.
GESTURE_ASYNC_ENABLED=true

# say()'s bundled gesture (see tools/registry.py's handle_say()) starts
# before speech is synthesized by default (false) - Cozmo reacts the
# instant `say` is called, but the overlap with speech isn't guaranteed if
# synthesis (TTS_PROVIDER/network/CPU-dependent) takes longer than the
# gesture itself - can happen with a slower TTS backend (e.g. local). Set
# true to synthesize first and only start the gesture once speech is
# actually ready to play - overlap is then guaranteed regardless of
# synthesis speed, at the cost of Cozmo appearing to pause (mood/face
# still update immediately either way, just no movement) for however long
# synthesis takes. Only matters when GESTURE_ASYNC_ENABLED is also true -
# gesture is fully sequential either way when it's false.
GESTURE_SPEECH_SYNC_ENABLED=false

# Whether the `look` tool's photo gets attached to the next LLM turn as an
# image (requires a vision-capable OLLAMA_MODEL). Set false to disable.
VISION_ENABLED=true

# --- Dashboard (dashboard.sh / python -m cozmo_dashboard) ---
# Only the dashboard reads these; the app itself ignores them.
# Port the Control Room web page listens on.
DASHBOARD_PORT=30540

# Address to listen on. 127.0.0.1 = reachable only from this machine (open
# it from another computer through an SSH tunnel). 0.0.0.0 = reachable from
# your whole network, e.g. to open it from your PC while it runs on the Pi -
# only do that together with DASHBOARD_TOKEN below, since the page can start
# and stop Cozmo and edit this file.
DASHBOARD_HOST=127.0.0.1

# Password for the dashboard (asked once per browser). Empty = no password.
# Set one whenever DASHBOARD_HOST is not 127.0.0.1.
# There is no default - make your own random one, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=
